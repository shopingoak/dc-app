# Telegram Bot Token (аз @BotFather дар Telegram гиред)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ID-и Telegram-и Admin (аз @userinfobot дар Telegram гиред)
# Барои якчанд админ бо вергул ҷудо кунед: 123456789,987654321
ADMIN_ID=YOUR_TELEGRAM_USER_ID_HERE

# Танзимоти шабакавии Сервер
HOST=0.0.0.0
PORT=8000

# Пойгоҳи додаҳо (Database)
DATABASE_URL=sqlite:///./dccity.db
